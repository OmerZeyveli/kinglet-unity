{
  "permissions": {
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/block-scene-edit.sh",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": ".claude/hooks/block-meta-edit.sh",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": ".claude/hooks/block-legacy-input.sh",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": ".claude/hooks/guard-project-config.sh",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/bash-gate.sh",
            "timeout": 3000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/warn-serialization.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": ".claude/hooks/warn-filename.sh",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": ".claude/hooks/warn-platform-defines.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": ".claude/hooks/track-edits.sh",
            "timeout": 2000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-restore.sh",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-brief.sh",
            "timeout": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-save.sh",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
