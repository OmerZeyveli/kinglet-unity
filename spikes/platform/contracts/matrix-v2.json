        "client.copilot-vscode.windows-11-x64.capability-suite",
        "client.cursor.windows-11-x64.capability-suite",
        "runtime.dotnet.windows-11-x64.host-probe",
        "runtime.go.windows-11-x64.host-probe",
        "runtime.python.windows-11-x64.host-probe",
        "runtime.rust.windows-11-x64.host-probe",
        "unity.editor-resolution.windows-11-x64.mismatched-editor",
        "unity.execution.windows-11-x64.cancellation",
        "unity.execution.windows-11-x64.orphan-cleanup",
        "unity.filesystem-only.windows-11-x64.route",
        "unity.isolated-headless.windows-11-x64.route",
        "unity.live-editor-mcp.windows-11-x64.bridge-not-ready",
        "unity.live-editor-mcp.windows-11-x64.route",
        "unity.same-project-headless.windows-11-x64.collision-refusal",
        "unity.same-project-headless.windows-11-x64.route"
      ],
      "date": "2026-07-29",
      "decided_by": "repository owner",
      "disposition": "deferred",
      "id": "2026-07-29-windows-11-deferred",
      "reason": "No Windows 11 machine is owned. The Windows 10 22H2 x64 host pass of 2026-07-28 is the Windows evidence the project stands on for now; a Windows 11 pass waits until the project is far enough along to justify borrowing a machine. Deferred rather than dropped: these cells are expected back, and re-running them requires no matrix change, only evidence."
    }
  ],
