{
  "amendments": [
    {
      "cells": [
        "runtime.dotnet.macos-26-x64.host-probe",
        "runtime.go.macos-26-x64.host-probe",
        "runtime.python.macos-26-x64.host-probe",
        "runtime.rust.macos-26-x64.host-probe"
      ],
      "date": "2026-07-29",
      "decided_by": "repository owner",
      "disposition": "dropped",
      "id": "2026-07-29-no-intel-mac",
      "reason": "No Intel Mac is owned and none is expected. Apple has shipped no Intel Mac since 2023 and macOS 26 is the last release to support any of them, so x86-64 macOS is a platform Kinglet does not target rather than one it has failed to test. Kept in the matrix as a dropped cell, not deleted, so the coverage report still shows that this was once required and why it stopped being so."
    },
    {
      "cells": [
        "client.antigravity.windows-11-x64.capability-suite",
        "client.claude-code.windows-11-x64.capability-suite",
        "client.codex.windows-11-x64.capability-suite",
