# ── OS cruft ──────────────────────────────────
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Editor / IDE ──────────────────────────────
.vscode/
.idea/
.worktrees/
.research/
.superpowers/
.kinglet/local/
*.swp
*.swo
*~

# ── Logs / temp / backups ─────────────────────
*.log
*.tmp
*.bak
*.orig

# ── Python caches ───────────────────────────────
__pycache__/
*.py[cod]

# ── Secrets (savunma amaçlı; repo'da olmamalı) ─
.env
.env.*

# ── Repo İÇİNDE test Unity projesi açarsan aç ──
# (tercihen ayrı projede test et; gerekirse bunları aç)
# [Ll]ibrary/
# [Tt]emp/
# [Oo]bj/
# [Bb]uild/

# Claude Code local settings and hook/session state.
# This repo is itself a Claude Code project, so its own hooks write here while the tests run.
.claude/settings.local.json
.claude/state/*
!.claude/state/.gitkeep

# Go host probe compiled binary (built from spikes/platform/runtime/go/)
spikes/platform/runtime/go/dist/
# bare `go build` emits the binary into the source dir — keep it out of git
spikes/platform/runtime/go/kinglet-host-probe

# Python host probe packaging output (PyInstaller dist/ + build/) and uv venv
spikes/platform/runtime/python/dist/
spikes/platform/runtime/python/build/
spikes/platform/runtime/python/.venv/

# Rust host probe build output (Cargo target dir)
spikes/platform/runtime/rust/target/

# .NET host probe build output (bin/ obj/ publish/)
spikes/platform/runtime/dotnet/**/bin/
spikes/platform/runtime/dotnet/**/obj/

# Native client capability probe build output (build.sh/build.ps1 -> dist/)
spikes/platform/clients/probe-host/dist/
